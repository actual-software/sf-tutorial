#!/usr/bin/env bash
#
# sfbox — drive your Software Factory Intensive boxes from your own laptop.
#
# You get an SSH key and a hostname from your instructor. Everything else
# happens here: save the credential once, then deploy, restart, inspect and
# tunnel into your Prod and Test boxes without an AWS account.
#
# State lives in $SFBOX_HOME (default ~/.gascity), which this CLI owns.
# It never edits ~/.ssh/config; it generates its own ssh_config and asks you
# to Include it once.

set -uo pipefail

SFBOX_VERSION="0.1.0"

SFBOX_HOME="${SFBOX_HOME:-$HOME/.gascity}"
SFBOX_BOXES="$SFBOX_HOME/boxes.toml"
SFBOX_KEYS="$SFBOX_HOME/keys"
SFBOX_KNOWN_HOSTS="$SFBOX_HOME/known_hosts"
SFBOX_SSH_CONFIG="$SFBOX_HOME/ssh_config"

# MAX_ARG_STRLEN on Linux. A rendered prompt is passed to the agent as a
# single argv entry (prompt_mode = "arg"), and the kernel counts the NUL
# terminator, so a prompt of exactly this many bytes already fails.
SFBOX_MAX_PROMPT_BYTES=131072

# Imports that belong to Gas City itself. deploy-factory never removes these;
# removing them breaks the city rather than swapping the factory.
SFBOX_PROTECTED_IMPORTS="core bd"

SFBOX_DEFAULT_USER="ubuntu"
SFBOX_DEFAULT_PORT="22"
SFBOX_DEFAULT_DASHBOARD_PORT="8372"
SFBOX_SERVICE="gas-city.service"

# ---------------------------------------------------------------- output ----

say()  { printf '==> %s\n' "$*"; }
warn() { printf '==> WARNING: %s\n' "$*" >&2; }
err()  { printf '==> ERROR: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# Quote a string for safe interpolation into a remote bash command.
rq() { printf '%q' "$1"; }

# ----------------------------------------------------------------- state ----

state_init() {
  mkdir -p "$SFBOX_HOME" "$SFBOX_KEYS" || die "cannot create $SFBOX_HOME"
  chmod 700 "$SFBOX_HOME" 2>/dev/null || true
  chmod 700 "$SFBOX_KEYS" 2>/dev/null || true
  [ -f "$SFBOX_BOXES" ] || : >"$SFBOX_BOXES"
  [ -f "$SFBOX_KNOWN_HOSTS" ] || : >"$SFBOX_KNOWN_HOSTS"
}

# boxes.toml -> flat "box<TAB>key<TAB>value" lines. Top-level keys use an
# empty box field. We own both sides of this file, so the parser only needs
# to handle the subset state_render emits.
state_flatten() {
  [ -f "$SFBOX_BOXES" ] || return 0
  awk '
    /^[[:space:]]*#/  { next }
    /^[[:space:]]*$/  { next }
    /^[[:space:]]*\[boxes\./ {
      line = $0
      sub(/^[[:space:]]*\[boxes\./, "", line)
      sub(/\][[:space:]]*$/, "", line)
      gsub(/"/, "", line)
      box = line
      next
    }
    /^[[:space:]]*\[/ { box = ""; next }
    /=/ {
      key = $0; val = $0
      sub(/=.*$/, "", key)
      sub(/^[^=]*=/, "", val)
      gsub(/^[[:space:]]+/, "", key); gsub(/[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+/, "", val); gsub(/[[:space:]]+$/, "", val)
      gsub(/^"/, "", val); gsub(/"$/, "", val)
      printf "%s\t%s\t%s\n", box, key, val
    }
  ' "$SFBOX_BOXES"
}

# flat lines on stdin -> boxes.toml on stdout.
state_render() {
  sort -t"$(printf '\t')" -k1,1 -k2,2 | awk -F'\t' '
    BEGIN { print "# Generated by sfbox. Edit with `sfbox save-credential` / `sfbox box`." }
    $1 == "" {
      if ($3 ~ /^[0-9]+$/) printf "%s = %s\n", $2, $3
      else                 printf "%s = \"%s\"\n", $2, $3
      next
    }
    {
      if ($1 != cur) { printf "\n[boxes.%s]\n", $1; cur = $1 }
      if ($3 ~ /^[0-9]+$/) printf "%s = %s\n", $2, $3
      else                 printf "%s = \"%s\"\n", $2, $3
    }
  '
}

state_get() { # box key -> value on stdout (empty if absent)
  local box="$1" key="$2"
  state_flatten | awk -F'\t' -v b="$box" -v k="$key" '$1==b && $2==k {print $3; exit}'
}

state_put() { # box key value
  local box="$1" key="$2" val="$3" tmp
  tmp="$(mktemp)" || die "mktemp failed"
  {
    state_flatten | awk -F'\t' -v b="$box" -v k="$key" '!($1==b && $2==k)'
    printf '%s\t%s\t%s\n' "$box" "$key" "$val"
  } | state_render >"$tmp"
  mv "$tmp" "$SFBOX_BOXES"
}

state_drop_box() { # box
  local box="$1" tmp
  tmp="$(mktemp)" || die "mktemp failed"
  state_flatten | awk -F'\t' -v b="$box" '$1!=b' | state_render >"$tmp"
  mv "$tmp" "$SFBOX_BOXES"
}

state_boxes() { state_flatten | awk -F'\t' '$1!="" {print $1}' | sort -u; }

state_has_box() { state_boxes | grep -qxF "$1"; }

state_current() { state_get "" current; }

state_set_current() { state_put "" current "$1"; }

# --------------------------------------------------------------- routing ----

# Resolve which box a command applies to: explicit --box, else the sticky one.
resolve_box() {
  local explicit="${1:-}"
  local box="$explicit"
  if [ -z "$box" ]; then
    box="$(state_current)"
  fi
  if [ -z "$box" ]; then
    err "no box selected"
    err "pass --box <boxId>, or set a sticky one with: sfbox box use <boxId>"
    exit 2
  fi
  if ! state_has_box "$box"; then
    err "unknown box '$box'"
    err "known boxes: $(state_boxes | tr '\n' ' ')"
    err "save one first with: sfbox save-credential --box $box --host <ip> --key <path> --fingerprint <fp>"
    exit 2
  fi
  printf '%s' "$box"
}

# ------------------------------------------------------------ ssh config ----

write_ssh_config() {
  local tmp box
  tmp="$(mktemp)" || die "mktemp failed"
  {
    echo "# Generated by sfbox — do not edit."
    echo "# Re-run 'sfbox save-credential' to regenerate."
    echo "# Add this line to the TOP of ~/.ssh/config to use these hosts natively:"
    echo "#   Include $SFBOX_SSH_CONFIG"
    while IFS= read -r box; do
      [ -n "$box" ] || continue
      echo
      echo "Host $box"
      echo "    HostName $(state_get "$box" host)"
      echo "    User $(state_get "$box" user)"
      echo "    Port $(state_get "$box" port)"
      echo "    IdentityFile $SFBOX_KEYS/$box.pem"
      echo "    IdentitiesOnly yes"
      echo "    UserKnownHostsFile $SFBOX_KNOWN_HOSTS"
      echo "    StrictHostKeyChecking yes"
    done < <(state_boxes)
  } >"$tmp"
  mv "$tmp" "$SFBOX_SSH_CONFIG"
  chmod 600 "$SFBOX_SSH_CONFIG" 2>/dev/null || true
}

# True when ~/.ssh/config already pulls our generated config in.
ssh_include_present() {
  local cfg="$HOME/.ssh/config"
  [ -f "$cfg" ] || return 1
  grep -qE "^[[:space:]]*Include[[:space:]]+.*(\.gascity/ssh_config|$(printf '%s' "$SFBOX_SSH_CONFIG" | sed 's/[][\.*^$/]/\\&/g'))" "$cfg"
}

report_include_hint() {
  if ssh_include_present; then
    say "~/.ssh/config already includes the sfbox config — 'ssh <boxId>' works natively."
    return 0
  fi
  echo
  say "One manual step left. Add this line to the TOP of ~/.ssh/config:"
  echo
  echo "    Include $SFBOX_SSH_CONFIG"
  echo
  say "sfbox itself works without it. The Include is what makes plain 'ssh <boxId>',"
  say "scp, rsync and port-forwards work too. sfbox never edits ~/.ssh/config for you."
}

# ------------------------------------------------------------------- ssh ----

box_ssh() { # box [args...]
  local box="$1"; shift
  ssh -F "$SFBOX_SSH_CONFIG" \
      -o ConnectTimeout=15 \
      -o BatchMode=yes \
      "$box" "$@"
}

box_ssh_interactive() { # box [args...]
  local box="$1"; shift
  ssh -F "$SFBOX_SSH_CONFIG" "$box" "$@"
}

# Run a gc command inside the box's city directory.
box_gc() { # box city_path gc-args...
  local box="$1" city="$2"; shift 2
  local args="" a
  for a in "$@"; do args="$args $(rq "$a")"; done
  box_ssh "$box" "cd $(rq "$city") && gc$args"
}

# Find the city directory on the box. Cached in boxes.toml once resolved.
resolve_city_path() { # box [override]
  local box="$1" override="${2:-}"
  if [ -n "$override" ]; then
    state_put "$box" city_path "$override"
    printf '%s' "$override"
    return 0
  fi
  local cached
  cached="$(state_get "$box" city_path)"
  if [ -n "$cached" ]; then printf '%s' "$cached"; return 0; fi

  local out count path
  out="$(box_ssh "$box" 'gc cities 2>/dev/null' || true)"
  # gc cities prints one path-bearing row per registered city.
  path="$(printf '%s\n' "$out" | grep -oE '/[^[:space:]]+' | head -1)"
  count="$(printf '%s\n' "$out" | grep -coE '/[^[:space:]]+' || true)"
  if [ -z "$path" ]; then
    err "could not find a Gas City directory on '$box'"
    err "pass it explicitly with --city-path <path>"
    return 3
  fi
  if [ "${count:-1}" -gt 1 ]; then
    warn "box '$box' has more than one city registered; using $path"
    warn "override with --city-path <path> if that is the wrong one"
  fi
  state_put "$box" city_path "$path"
  printf '%s' "$path"
}

# -------------------------------------------------------------- commands ----

cmd_save_credential() {
  local box="" host="" key="" fingerprint="" user="$SFBOX_DEFAULT_USER"
  local port="$SFBOX_DEFAULT_PORT" label="" city="" rotate=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --box)         box="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --host)        host="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --key)         key="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --fingerprint) fingerprint="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --user)        user="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --port)        port="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --label)       label="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --city)        city="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --rotate)      rotate=1; shift ;;
      -h|--help)     usage_save_credential; return 0 ;;
      *)             die "save-credential: unknown argument '$1'" ;;
    esac
  done

  [ -n "$box" ]  || die "save-credential: --box <boxId> is required"
  [ -n "$host" ] || die "save-credential: --host <ip-or-hostname> is required"
  [ -n "$key" ]  || die "save-credential: --key <path-to-private-key> is required"
  if [ -z "$fingerprint" ]; then
    err "save-credential: --fingerprint <fp> is required"
    err "Your instructor emits it alongside the key. Pinning it at save time means"
    err "your first connection is authenticated rather than trusted blindly, and a"
    err "rebuilt box reports 'replaced' instead of looking like an attack."
    exit 2
  fi
  case "$label" in
    ""|prod|test) ;;
    *) die "save-credential: --label must be 'prod' or 'test' (got '$label')" ;;
  esac
  case "$port" in
    ''|*[!0-9]*) die "save-credential: --port must be numeric (got '$port')" ;;
  esac

  state_init

  # --- key validation (guardrail 2) --------------------------------------
  [ -f "$key" ] || die "no such key file: $key"
  if ! grep -q -- "-----BEGIN .*PRIVATE KEY-----" "$key" 2>/dev/null; then
    err "'$key' does not look like a private key."
    err "Expected a PEM file containing a '-----BEGIN ... PRIVATE KEY-----' header."
    err "If you were given a .pub file, that is the public half — you need the other one."
    exit 2
  fi
  local dest="$SFBOX_KEYS/$box.pem"
  cp "$key" "$dest" || die "could not copy key to $dest"
  if ! chmod 600 "$dest"; then
    rm -f "$dest"
    die "could not set mode 0600 on $dest — refusing to store a world-readable key"
  fi
  local mode
  mode="$(ls -l "$dest" | cut -c1-10)"
  case "$mode" in
    -rw-------) ;;
    *) rm -f "$dest"; die "key at $dest is $mode, not 0600 — refusing to store it" ;;
  esac

  # --- host key pinning ---------------------------------------------------
  say "Fetching the host key from $host:$port ..."
  local scan
  scan="$(ssh-keyscan -p "$port" -T 10 "$host" 2>/dev/null | grep -v '^#' || true)"
  [ -n "$scan" ] || die "no host key returned by $host:$port — is the box up and :22 reachable?"

  local actual_fps
  actual_fps="$(printf '%s\n' "$scan" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')"
  if ! printf '%s\n' "$actual_fps" | grep -qxF "$fingerprint"; then
    err "HOST KEY MISMATCH for '$box' ($host)."
    err "expected: $fingerprint"
    err "offered:  $(printf '%s' "$actual_fps" | tr '\n' ' ')"
    err ""
    err "If your instructor rebuilt this box, that is expected. Ask them for the NEW"
    err "fingerprint and re-run with it, adding --rotate to replace the pin you saved."
    err "--rotate on its own will not help: the fingerprint you pass still has to match."
    err "If they did not rebuild it, stop and tell them before connecting."
    rm -f "$dest"
    exit 4
  fi
  say "Host key matches the fingerprint you were given."

  # Replace any prior pin for this host, then write the verified one.
  if [ -s "$SFBOX_KNOWN_HOSTS" ]; then
    local had_entry=0
    ssh-keygen -F "$host" -f "$SFBOX_KNOWN_HOSTS" >/dev/null 2>&1 && had_entry=1
    if [ "$had_entry" = 1 ]; then
      if [ "$rotate" = 0 ]; then
        say "Re-pinning the existing entry for $host (fingerprint already verified)."
      else
        say "Rotating the pinned host key for $host, as requested."
      fi
      ssh-keygen -R "$host" -f "$SFBOX_KNOWN_HOSTS" >/dev/null 2>&1 || true
    fi
  fi
  printf '%s\n' "$scan" >>"$SFBOX_KNOWN_HOSTS"
  chmod 600 "$SFBOX_KNOWN_HOSTS" 2>/dev/null || true

  # --- record + regenerate ------------------------------------------------
  state_put "$box" host "$host"
  state_put "$box" user "$user"
  state_put "$box" port "$port"
  [ -n "$label" ] && state_put "$box" label "$label"
  [ -n "$city" ]  && state_put "$box" city "$city"
  state_put "$box" fingerprint "$fingerprint"
  write_ssh_config
  [ -n "$(state_current)" ] || state_set_current "$box"

  say "Saved '$box' ($user@$host:$port)."
  say "Key:         $dest (0600)"
  say "Known hosts: $SFBOX_KNOWN_HOSTS (pinned)"
  say "Current box: $(state_current)"
  report_include_hint
}

cmd_box() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      state_init
      local cur box
      cur="$(state_current)"
      if [ -z "$(state_boxes)" ]; then
        say "No boxes saved yet."
        say "Add one: sfbox save-credential --box <id> --host <ip> --key <path> --fingerprint <fp>"
        return 0
      fi
      printf '%-3s %-20s %-22s %-6s %s\n' "" "BOX" "HOST" "LABEL" "CITY PATH"
      while IFS= read -r box; do
        [ -n "$box" ] || continue
        local marker=" "
        [ "$box" = "$cur" ] && marker="*"
        printf '%-3s %-20s %-22s %-6s %s\n' "$marker" "$box" \
          "$(state_get "$box" user)@$(state_get "$box" host)" \
          "$(state_get "$box" label)" \
          "$(state_get "$box" city_path)"
      done < <(state_boxes)
      echo
      say "* = current box. Change it with: sfbox box use <boxId>"
      ;;
    use)
      state_init
      local box="${1:-}"
      [ -n "$box" ] || die "box use: needs a boxId"
      state_has_box "$box" || die "unknown box '$box' (known: $(state_boxes | tr '\n' ' '))"
      state_set_current "$box"
      say "Current box is now '$box'."
      ;;
    current)
      state_init
      local cur; cur="$(state_current)"
      [ -n "$cur" ] || { say "No current box set."; return 0; }
      printf '%s\n' "$cur"
      ;;
    forget)
      state_init
      local box="${1:-}"
      [ -n "$box" ] || die "box forget: needs a boxId"
      state_has_box "$box" || die "unknown box '$box'"
      state_drop_box "$box"
      rm -f "$SFBOX_KEYS/$box.pem"
      [ "$(state_current)" = "$box" ] && state_put "" current ""
      write_ssh_config
      say "Forgot '$box' and removed its key. The box itself is untouched."
      ;;
    *)
      die "box: unknown subcommand '$sub' (want: list, use, current, forget)"
      ;;
  esac
}

cmd_preflight() {
  local box_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --box) box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help) echo "usage: sfbox preflight [--box <boxId>]"; return 0 ;;
      *) die "preflight: unknown argument '$1'" ;;
    esac
  done
  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?

  say "Checking '$box' ($(state_get "$box" user)@$(state_get "$box" host)) ..."
  local ok=0

  if box_ssh "$box" 'echo ok' >/dev/null 2>&1; then
    say "  ssh            reachable"
  else
    err "  ssh            FAILED"
    err "  Your SSH is the problem, not your factory. Check that the box is running,"
    err "  that :22 is open to you, and that the key you saved is the right one."
    ok=1
  fi

  if [ "$ok" = 0 ]; then
    if box_ssh "$box" 'command -v gc' >/dev/null 2>&1; then
      say "  gc             installed"
    else
      err "  gc             NOT FOUND on the box"
      ok=1
    fi
    local active
    active="$(box_ssh "$box" "systemctl is-active $SFBOX_SERVICE" 2>/dev/null || true)"
    if [ "$active" = "active" ]; then
      say "  $SFBOX_SERVICE  active"
    else
      warn "  $SFBOX_SERVICE  ${active:-unknown}"
    fi
  fi

  return "$ok"
}

cmd_start_session() {
  local box_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --box) box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help) echo "usage: sfbox start-session [--box <boxId>]"; return 0 ;;
      *) die "start-session: unknown argument '$1'" ;;
    esac
  done
  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?
  say "Opening a shell on '$box'. Exit it with Ctrl-D."
  exec ssh -F "$SFBOX_SSH_CONFIG" "$box"
}

cmd_get_box() {
  local box_arg="" lines=40
  while [ $# -gt 0 ]; do
    case "$1" in
      --box)   box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --lines) lines="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help) echo "usage: sfbox get-box [--box <boxId>] [--lines <n>]"; return 0 ;;
      *) die "get-box: unknown argument '$1'" ;;
    esac
  done
  case "$lines" in
    ''|*[!0-9]*) die "get-box: --lines must be numeric (got '$lines')" ;;
  esac
  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?

  echo "=== box ==="
  printf 'boxId       %s\n' "$box"
  printf 'host        %s@%s:%s\n' "$(state_get "$box" user)" "$(state_get "$box" host)" "$(state_get "$box" port)"
  printf 'label       %s\n' "$(state_get "$box" label)"
  printf 'city path   %s\n' "$(state_get "$box" city_path)"

  echo
  echo "=== service ==="
  box_ssh "$box" "systemctl is-active $SFBOX_SERVICE" 2>&1 || true

  echo
  echo "=== sessions ==="
  local city
  city="$(resolve_city_path "$box")" || { err "skipping sessions — no city path"; city=""; }
  if [ -n "$city" ]; then
    box_gc "$box" "$city" session list 2>&1 || warn "gc session list failed"
  fi

  echo
  echo "=== recent log (journalctl -u $SFBOX_SERVICE, last $lines) ==="
  # journalctl is the only log surface on the box; there is no supervisor.log.
  box_ssh "$box" "journalctl -u $SFBOX_SERVICE -n $(rq "$lines") --no-pager" 2>&1 || true
}

cmd_restart_factory() {
  local box_arg="" wait_secs=180
  while [ $# -gt 0 ]; do
    case "$1" in
      --box)  box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --wait) wait_secs="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help) echo "usage: sfbox restart-factory [--box <boxId>] [--wait <seconds>]"; return 0 ;;
      *) die "restart-factory: unknown argument '$1'" ;;
    esac
  done
  # An unvalidated --wait is worse than it looks: the poll below compares it
  # with -lt, which errors on a non-numeric operand and drops straight out of
  # the loop, so the restart would report its verdict immediately instead of
  # waiting the 30 to 90 seconds it actually needs.
  case "$wait_secs" in
    ''|*[!0-9]*) die "restart-factory: --wait must be numeric (got '$wait_secs')" ;;
  esac
  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?
  restart_factory "$box" "$wait_secs"
}

# Shared by restart-factory and the tail of deploy-factory.
restart_factory() { # box wait_secs
  local box="$1" wait_secs="$2"

  say "Restarting $SFBOX_SERVICE on '$box'."
  say "This normally takes 30 to 90 seconds. The stop phase can sit there a while"
  say "tearing sessions down — that is the service working, not hanging."

  # sudo needs no TTY here: sudoers grants NOPASSWD and there is no requiretty.
  if ! ssh -F "$SFBOX_SSH_CONFIG" -o ConnectTimeout=15 -o ServerAliveInterval=15 \
        "$box" "sudo systemctl restart $SFBOX_SERVICE"; then
    err "restart command failed on '$box'"
    err "check the log with: sfbox get-box --box $box"
    return 1
  fi

  local waited=0 active=""
  while [ "$waited" -lt "$wait_secs" ]; do
    active="$(box_ssh "$box" "systemctl is-active $SFBOX_SERVICE" 2>/dev/null || true)"
    if [ "$active" = "active" ]; then
      say "$SFBOX_SERVICE is active again after ${waited}s."
      return 0
    fi
    sleep 5
    waited=$((waited + 5))
  done

  warn "$SFBOX_SERVICE is '${active:-unknown}' after ${wait_secs}s."
  warn "It may still be coming up. Check with: sfbox get-box --box $box"
  return 1
}

cmd_dashboard() {
  local box_arg="" port="$SFBOX_DEFAULT_DASHBOARD_PORT"
  while [ $# -gt 0 ]; do
    case "$1" in
      --box)  box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --port) port="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help) echo "usage: sfbox dashboard [--box <boxId>] [--port <local-port>]"; return 0 ;;
      *) die "dashboard: unknown argument '$1'" ;;
    esac
  done
  case "$port" in
    ''|*[!0-9]*) die "dashboard: --port must be numeric (got '$port')" ;;
  esac
  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?

  say "Tunnelling the dashboard from '$box' to http://127.0.0.1:$port"
  say "The SPA is embedded in the gc binary and served by the supervisor, so there"
  say "is nothing to start on the box. Open that URL in your browser."
  say "Leave this running; Ctrl-C closes the tunnel."
  echo
  # Loopback-only on both ends: the security group still opens :22 alone, and
  # the API keeps full read-write because it is same-origin over the tunnel.
  exec ssh -F "$SFBOX_SSH_CONFIG" -N \
      -L "$port:127.0.0.1:$SFBOX_DEFAULT_DASHBOARD_PORT" "$box"
}

# ------------------------------------------------------- deploy-factory -----

# Turn a GitHub tree/repo URL into "<org>/<repo>" and a ref, for sha lookup.
parse_github_url() { # url -> prints "org repo ref subdir"
  local url="$1" rest org repo ref="" subdir=""
  case "$url" in
    https://github.com/*) rest="${url#https://github.com/}" ;;
    *) return 1 ;;
  esac
  rest="${rest%/}"
  org="${rest%%/*}"
  # A bare org with no repo segment is not a pack URL. Reject it here: "${rest#*/}"
  # leaves $rest untouched when there is no slash, so the org would otherwise be
  # reused as the repo name and fail much later as "could not resolve acme/acme".
  [ "$rest" != "$org" ] || return 1
  rest="${rest#*/}"
  if [ -n "$rest" ]; then repo="${rest%%/*}"; rest="${rest#"$repo"}"; rest="${rest#/}"; fi
  repo="${repo%.git}"
  [ -n "$org" ] && [ -n "$repo" ] || return 1
  if [ -n "$rest" ]; then
    case "$rest" in
      tree/*) rest="${rest#tree/}"; ref="${rest%%/*}"; subdir="${rest#"$ref"}"; subdir="${subdir#/}" ;;
      *) return 1 ;;
    esac
  fi
  printf '%s %s %s %s\n' "$org" "$repo" "$ref" "$subdir"
}

# Resolve a ref to a commit sha through the public GitHub API (no auth needed).
resolve_commit_sha() { # org repo ref
  local org="$1" repo="$2" ref="${3:-HEAD}"
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsSL "https://api.github.com/repos/$org/$repo/commits/$ref" 2>/dev/null \
    | sed -n 's/^[[:space:]]*"sha"[[:space:]]*:[[:space:]]*"\([0-9a-f]\{40\}\)".*/\1/p' \
    | head -1
}

# The highest-value guardrail. Render every agent on the box and refuse if any
# rendered prompt is too large to exec.
#
# Why --strict matters: without it, gc prime silently falls back to a short
# default worker prompt for an agent it cannot resolve, so an oversized pack
# would measure small and sail through the check it is supposed to fail.
#
# Why --json matters: the bytes field is the exact UTF-8 length of the string
# that prompt_mode="arg" hands to execve, which is the thing the kernel is
# measuring when it refuses. Piping the plain output through wc -c agrees
# today, measured identical on nine agents from 905 to 299,395 bytes, but it
# is a proxy on what gc happened to print rather than the length itself.
#
# The reader cuts the JSON at "content" before it looks for a size, so a
# rendered prompt that itself contains the word bytes cannot be mistaken for
# the measurement. If the field ever moves or disappears the size comes back
# empty, and evaluate_prompt_sizes refuses on an unreadable size rather than
# passing it, so the whole path stays fail-closed.
check_prompt_sizes() { # box city_path -> 0 ok, 1 oversized, 3 could-not-measure
  local box="$1" city="$2"

  say "Rendering every agent prompt to check it can actually start ..."
  local remote out
  remote="cd $(rq "$city") || exit 3
tmp=\$(mktemp) || exit 3
gc agent list 2>/dev/null | awk '/^[[:space:]]/ {print \$1}' | while read -r a; do
  [ -n \"\$a\" ] || continue
  if gc prime \"\$a\" --strict --json >\"\$tmp\" 2>/dev/null; then
    printf '%s\tOK\t%s\n' \"\$a\" \"\$(head -c 512 \"\$tmp\" | sed 's/\"content\":.*//' | grep -o '\"bytes\":[0-9]*' | head -1 | tr -dc '0-9')\"
  else
    printf '%s\tERR\t0\n' \"\$a\"
  fi
done
rm -f \"\$tmp\""

  out="$(box_ssh "$box" "$remote" 2>/dev/null)"
  if [ -z "$out" ]; then
    err "could not render any agent prompt on '$box'."
    err "Without that measurement the size guardrail cannot run, so the deploy stops here."
    return 3
  fi
  printf '%s\n' "$out" | evaluate_prompt_sizes
}

# The decision half of the guardrail, split out so it can be tested without a
# box: reads "<agent>\t<OK|ERR>\t<bytes>" lines and returns 0 pass, 1 refuse.
evaluate_prompt_sizes() {
  local out oversized=0 unreadable=0 largest=0 agent status bytes
  out="$(cat)"
  [ -n "$out" ] || return 3
  while IFS="$(printf '\t')" read -r agent status bytes; do
    [ -n "$agent" ] || continue
    if [ "$status" = "ERR" ]; then
      warn "  $agent: could not render (gc prime --strict --json failed)"
      unreadable=$((unreadable + 1))
      continue
    fi
    # A size that is not a number means the measurement broke, not that the
    # prompt fits. Without this the -ge test below errors and falls through to
    # the "fits" branch, which is the one failure this guardrail must not have.
    case "$bytes" in
      ''|*[!0-9]*)
        warn "  $agent: could not read a size (got '$bytes')"
        unreadable=$((unreadable + 1))
        continue ;;
    esac
    if [ "$bytes" -ge "$SFBOX_MAX_PROMPT_BYTES" ]; then
      err "  $agent: $bytes bytes — TOO LARGE"
      oversized=$((oversized + 1))
    else
      say "  $agent: $bytes bytes"
      [ "$bytes" -gt "$largest" ] && largest="$bytes"
    fi
  done <<<"$out"

  if [ "$oversized" -gt 0 ]; then
    echo
    err "This pack cannot start on the box. $oversized agent prompt(s) render to at least"
    err "$SFBOX_MAX_PROMPT_BYTES bytes, and Linux caps a single argument at that size"
    err "(MAX_ARG_STRLEN, counting the terminator). Gas City passes the whole rendered"
    err "prompt as one argument, so exec fails every time — and it is reported as"
    err "'session died during startup', which points at the wrong layer entirely."
    err ""
    err "Nothing was restarted, and the import has been rolled back, so your box is"
    err "still running the factory it was running before."
    err ""
    err "To fix it, shrink the rendered prompt — not just the template. Most of the"
    err "size usually comes from what gets injected at render time, so trimming prose"
    err "in the template alone tends not to be enough."
    return 1
  fi
  if [ "$unreadable" -gt 0 ]; then
    echo
    err "$unreadable agent(s) could not be rendered, so this pack is not safe to start."
    err "Run 'gc prime <agent> --strict' on the box to see why."
    return 1
  fi
  say "All agent prompts fit. Largest is $largest bytes of $SFBOX_MAX_PROMPT_BYTES."
  return 0
}

cmd_deploy_factory() {
  local box_arg="" pack_url="" version="" city_override="" assume_yes=0 keep_existing=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --box)        box_arg="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --version)    version="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --city-path)  city_override="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --keep-existing) keep_existing=1; shift ;;
      -y|--yes)     assume_yes=1; shift ;;
      -h|--help)    usage_deploy_factory; return 0 ;;
      -*)           die "deploy-factory: unknown argument '$1'" ;;
      *)            [ -z "$pack_url" ] && pack_url="$1" || die "deploy-factory: unexpected argument '$1'"; shift ;;
    esac
  done
  [ -n "$pack_url" ] || { usage_deploy_factory; exit 2; }

  state_init
  local box; box="$(resolve_box "$box_arg")" || exit $?

  local parsed org repo ref subdir
  parsed="$(parse_github_url "$pack_url")" || die "not a GitHub URL: $pack_url
Expected something like https://github.com/<org>/<repo>/tree/<ref>/<subdir>"
  read -r org repo ref subdir <<<"$parsed"

  # gc pins by commit, so resolve the ref unless the caller already pinned it.
  if [ -z "$version" ]; then
    say "Resolving ${ref:-default branch} of $org/$repo to a commit ..."
    local sha
    sha="$(resolve_commit_sha "$org" "$repo" "$ref")"
    [ -n "$sha" ] || die "could not resolve $org/$repo@${ref:-HEAD} to a commit.
Pass it yourself with --version sha:<commit>."
    version="sha:$sha"
  fi
  say "Pack:    $pack_url"
  say "Version: $version"

  say "Checking connectivity to '$box' first ..."
  box_ssh "$box" 'echo ok' >/dev/null 2>&1 \
    || die "cannot reach '$box' over ssh. Run 'sfbox preflight --box $box' to see why."

  local city
  city="$(resolve_city_path "$box" "$city_override")" || exit 3
  say "City:    $city"

  # Snapshot the current imports. This is both the removal list and, if the
  # size check refuses the pack, the rollback plan.
  local snapshot
  snapshot="$(box_gc "$box" "$city" import list 2>/dev/null)" \
    || die "could not read the current imports on '$box'"

  local to_remove=""
  if [ "$keep_existing" = 0 ]; then
    local name
    while IFS="$(printf '\t')" read -r name _rest; do
      [ -n "$name" ] || continue
      case " $SFBOX_PROTECTED_IMPORTS " in
        *" $name "*) continue ;;
      esac
      to_remove="$to_remove $name"
    done <<<"$snapshot"
  fi

  echo
  say "Plan for '$box':"
  say "  1. add     $pack_url ($version)"
  if [ -n "$to_remove" ]; then
    say "  2. remove ${to_remove# } (so the new pack is the top-level one)"
  else
    say "  2. remove nothing"
  fi
  say "  3. install"
  say "  4. check every rendered agent prompt fits in $SFBOX_MAX_PROMPT_BYTES bytes"
  say "  5. restart $SFBOX_SERVICE — only if step 4 passes"
  echo
  if [ "$assume_yes" = 0 ]; then
    printf '==> Continue? [y/N] '
    local reply; read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) say "Nothing changed."; return 0 ;; esac
  fi

  local pack_name="$repo"
  [ -n "$subdir" ] && pack_name="$(basename "$subdir")"

  say "Adding the import ..."
  box_gc "$box" "$city" import add "$pack_url" --version "$version" \
    || die "gc import add failed — nothing changed on the box"

  local n
  for n in $to_remove; do
    say "Removing '$n' ..."
    box_gc "$box" "$city" import remove "$n" || warn "gc import remove $n failed; continuing"
  done

  say "Installing ..."
  if ! box_gc "$box" "$city" import install; then
    err "gc import install failed."
    rollback_imports "$box" "$city" "$snapshot" "$pack_name"
    exit 1
  fi

  # The guardrail runs here: after install so the pack is real, before the
  # restart so a refusal leaves the running factory untouched.
  check_prompt_sizes "$box" "$city"
  local check_rc=$?
  if [ "$check_rc" != 0 ]; then
    rollback_imports "$box" "$city" "$snapshot" "$pack_name"
    exit 1
  fi

  restart_factory "$box" 180 || exit 1
  echo
  say "Deployed. Look around with: sfbox get-box --box $box"
  say "Or open the dashboard:      sfbox dashboard --box $box"
}

# Put the imports back the way we found them. Safe to call before the restart:
# the service is still running the configuration it started with.
rollback_imports() { # box city snapshot new_pack_name
  local box="$1" city="$2" snapshot="$3" new_pack="$4"
  warn "Rolling the imports back to how they were ..."
  box_gc "$box" "$city" import remove "$new_pack" >/dev/null 2>&1 \
    || warn "could not remove '$new_pack'; check 'gc import list' on the box"
  local name source version _locked
  while IFS="$(printf '\t')" read -r name source version _locked; do
    [ -n "$name" ] || continue
    case " $SFBOX_PROTECTED_IMPORTS " in
      *" $name "*) continue ;;
    esac
    box_gc "$box" "$city" import add "$source" --version "$version" >/dev/null 2>&1 \
      || warn "could not restore import '$name' ($source $version)"
  done <<<"$snapshot"
  if box_gc "$box" "$city" import install >/dev/null 2>&1; then
    warn "Imports restored. The factory was never restarted, so it is still running."
  else
    err "Could not reinstall the previous imports."
    err "Your running factory is untouched, but the on-disk import list may be mixed."
    err "Inspect it with: sfbox start-session --box $box, then 'gc import list'."
  fi
}

# ------------------------------------------------------------ instructor ----
#
# These three are for the instructor, who holds the AWS account. Participants
# deliberately have none, so every one of them stops on a clear message rather
# than an SDK stack trace when credentials are missing.
#
# provision and remove drive Terraform rather than the EC2 API directly. That
# keeps state truthful and takes the whole dependent graph with it on remove:
# a raw terminate-instances is faster but leaks elastic IPs and volumes that
# bill quietly across a cohort.

SFBOX_DEFAULT_TAG_KEY="Workshop"
SFBOX_DEFAULT_TAG_VALUE="sfi"

# Set by the instructor commands from --region / --profile.
SFBOX_AWS_REGION="${SFBOX_AWS_REGION:-}"
SFBOX_AWS_PROFILE="${SFBOX_AWS_PROFILE:-}"

# External-command seams. The test suite replaces these so it can exercise the
# plumbing without touching live AWS — no apply, no destroy, no billing.
aws_available() { command -v aws >/dev/null 2>&1; }
tf_available()  { command -v terraform >/dev/null 2>&1; }

aws_cli() {
  local extra=()
  [ -n "$SFBOX_AWS_REGION" ]  && extra+=(--region "$SFBOX_AWS_REGION")
  [ -n "$SFBOX_AWS_PROFILE" ] && extra+=(--profile "$SFBOX_AWS_PROFILE")
  command aws ${extra[@]+"${extra[@]}"} "$@"
}

tf_cli()      { command terraform "$@"; }
keyscan_cli() { command ssh-keyscan "$@"; }
keygen_cli()  { command ssh-keygen "$@"; }

# A boxId becomes the Terraform factory_name, which in turn names AWS resources
# and the Terraform workspace. Reject anything that would land somewhere odd
# rather than letting it fail three layers down inside an apply.
instructor_validate_box_id() { # boxId
  local box="${1:-}"
  if [ -z "$box" ]; then
    err "this command needs a boxId, for example: alice-prod"
    return 2
  fi
  case "$box" in
    *[!a-zA-Z0-9-]*)
      err "invalid boxId '$box' — use letters, digits and hyphens only."
      err "It becomes the Terraform factory_name and names AWS resources, so it"
      err "cannot carry spaces, slashes or dots."
      return 2 ;;
  esac
  case "$box" in
    -*|*-) err "invalid boxId '$box' — it cannot start or end with a hyphen."; return 2 ;;
  esac
  if [ "${#box}" -gt 60 ]; then
    err "invalid boxId '$box' — keep it to 60 characters or fewer."
    return 2
  fi
  return 0
}

# The guard that keeps a participant from meeting a raw SDK error. Participants
# have no AWS credentials by design, so "you ran an instructor command" is the
# useful thing to say, not "Unable to locate credentials".
instructor_require_aws() {
  if ! aws_available; then
    err "the AWS CLI is not installed, so this instructor command cannot run."
    err ""
    err "'sfbox instructor ...' is for whoever runs the workshop and holds the AWS"
    err "account. If you are a participant, you are not missing anything: you drive"
    err "your boxes with the other sfbox commands and you never need AWS access."
    err "Run 'sfbox --help' to see the ones meant for you."
    return 5
  fi
  if ! aws_cli sts get-caller-identity >/dev/null 2>&1; then
    err "no working AWS credentials, so this instructor command cannot run."
    err ""
    err "'sfbox instructor ...' is for whoever runs the workshop and holds the AWS"
    err "account. If you are a participant, you are not missing anything: you drive"
    err "your boxes with the other sfbox commands and you never need AWS access."
    err "Run 'sfbox --help' to see the ones meant for you."
    err ""
    err "If you ARE the instructor, your session has probably expired. Check with:"
    err "  aws sts get-caller-identity${SFBOX_AWS_PROFILE:+ --profile $SFBOX_AWS_PROFILE}"
    err "Nothing was changed."
    return 5
  fi
  return 0
}

instructor_require_tf() { # tf_root
  local root="${1:-}"
  if ! tf_available; then
    err "terraform is not installed, and provision/remove drive Terraform rather"
    err "than the EC2 API so that state stays truthful and nothing billable orphans."
    return 5
  fi
  if [ -z "$root" ]; then
    err "no Terraform root given."
    err "Pass --tf-root <dir>, or set SFBOX_TF_ROOT in your environment."
    err "It is the workspace you copied from actualclaw's"
    err "modules/gas-city-instance/example/ and filled in for this cohort."
    return 2
  fi
  if [ ! -d "$root" ]; then
    err "no such Terraform root: $root"
    return 2
  fi
  if ! ls "$root"/*.tf >/dev/null 2>&1; then
    err "'$root' has no .tf files in it, so it is not a Terraform root."
    err "Point --tf-root at the workspace you copied from actualclaw's"
    err "modules/gas-city-instance/example/."
    return 2
  fi
  return 0
}

# One row per instance: name, id, state, type, public ip, private ip, launched.
# Kept as its own function so the formatter below can be tested against fixture
# rows without an AWS call in sight.
#
# Two things callers depend on. The exit status is the describe's own, because a
# denied ec2:DescribeInstances, a throttle and a wrong --region all print an
# empty table, so an errored lookup and an empty account are indistinguishable
# without it. And AWS's own error is left on stderr rather than swallowed: by
# the time this runs, credentials have already resolved, so whatever it says is
# the instructor's business, and it lands right above the framing below.
instructor_describe_rows() { # tag_key tag_value [name_filter]
  local tag_key="$1" tag_value="$2" name="${3:-}"
  local filters=("Name=tag:$tag_key,Values=$tag_value")
  [ -n "$name" ] && filters+=("Name=tag:Name,Values=$name")
  aws_cli ec2 describe-instances \
    --filters ${filters[@]+"${filters[@]}"} \
    --query 'Reservations[].Instances[].[Tags[?Key==`Name`]|[0].Value,InstanceId,State.Name,InstanceType,PublicIpAddress,PrivateIpAddress,LaunchTime]' \
    --output text
}

# provision and list both hang off that one describe, and both have to treat a
# failed lookup as a different answer from an empty one. Shared so the two
# commands cannot drift apart on what they tell the instructor.
instructor_report_lookup_failure() { # consequence
  err "could not complete the EC2 lookup, so $1"
  err "Any error the AWS CLI printed is just above this."
  err ""
  err "This is not the same as finding nothing, which is why it stops here."
  err "The usual causes:"
  err "  - these credentials are missing ec2:DescribeInstances"
  err "  - the call was throttled, so waiting a moment and re-running may be all it takes"
  err "  - --region points somewhere your boxes are not"
  err ""
  err "Check it directly with:"
  err "  aws ec2 describe-instances --max-items 1${SFBOX_AWS_REGION:+ --region $SFBOX_AWS_REGION}${SFBOX_AWS_PROFILE:+ --profile $SFBOX_AWS_PROFILE}"
}

# Drop rows AWS still reports but that no longer hold a boxId: a terminated
# instance keeps its tags for a while, and counting one as live would refuse a
# boxId the instructor is entitled to reuse.
instructor_live_rows() {
  awk -F'\t' 'NF >= 3 && $3 != "terminated" && $3 != "shutting-down"'
}

# Rows on stdin -> the table the instructor reads. Pure formatting, no AWS.
instructor_format_rows() {
  awk -F'\t' '
    BEGIN { n = 0 }
    NF >= 3 {
      n++
      name = ($1 == "" || $1 == "None") ? "(untagged)" : $1
      pub  = ($5 == "" || $5 == "None") ? "-" : $5
      priv = ($6 == "" || $6 == "None") ? "-" : $6
      if (n == 1) printf "%-22s %-20s %-12s %-12s %-16s %s\n", "BOX", "INSTANCE", "STATE", "TYPE", "PUBLIC IP", "PRIVATE IP"
      printf "%-22s %-20s %-12s %-12s %-16s %s\n", name, $2, $3, $4, pub, priv
    }
    END { if (n == 0) print "__SFBOX_NO_ROWS__" }
  '
}

# 0 when a live instance already carries this boxId, 1 when it is free, and 2
# when the lookup could not be completed. That third answer has to be its own:
# the instructor allocates ids by hand, so a collision is an error rather than a
# silent overwrite of somebody else's box, and a failed lookup that read as
# "free" would apply straight over it. Note the describe runs on its own rather
# than piped, so its exit status survives to be checked.
instructor_box_exists() { # boxId tag_key tag_value
  local box="$1" tag_key="$2" tag_value="$3" rows
  rows="$(instructor_describe_rows "$tag_key" "$tag_value" "$box")" || return 2
  rows="$(printf '%s\n' "$rows" | instructor_live_rows)"
  [ -n "$rows" ]
}

# Select the per-box Terraform workspace, creating it on first use. Without
# this every box would share one state file and provisioning the second box
# would destroy the first.
instructor_tf_workspace() { # tf_root boxId
  local root="$1" box="$2"
  tf_cli -chdir="$root" workspace select "$box" >/dev/null 2>&1 && return 0
  tf_cli -chdir="$root" workspace new "$box" >/dev/null 2>&1 && return 0
  err "could not select or create the Terraform workspace '$box' in $root"
  return 1
}

# Read one output from the applied root. Returns empty when it is not declared,
# which the caller treats as "not available" rather than as an error.
instructor_tf_output() { # tf_root name
  tf_cli -chdir="$1" output -raw "$2" 2>/dev/null
}

cmd_instructor_provision() {
  local box="" tf_root="${SFBOX_TF_ROOT:-}" packs_ref="" keypair="" key_out=""
  local tag_key="$SFBOX_DEFAULT_TAG_KEY" tag_value="$SFBOX_DEFAULT_TAG_VALUE"
  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tf-root)            tf_root="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --factory-packs-ref)  packs_ref="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --keypair)            keypair="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --key-out)            key_out="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --region)             SFBOX_AWS_REGION="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --profile)            SFBOX_AWS_PROFILE="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --tag-key)            tag_key="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --tag-value)          tag_value="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -y|--yes)             assume_yes=1; shift ;;
      -h|--help)            usage_instructor; return 0 ;;
      -*)                   err "instructor provision: unknown argument '$1'"; return 2 ;;
      *)                    if [ -z "$box" ]; then box="$1"; shift
                            else err "instructor provision: unexpected argument '$1'"; return 2; fi ;;
    esac
  done

  instructor_validate_box_id "$box" || return $?
  instructor_require_aws || return $?
  instructor_require_tf "$tf_root" || return $?

  say "Checking whether '$box' is already taken ..."
  local taken
  instructor_box_exists "$box" "$tag_key" "$tag_value"
  taken=$?
  if [ "$taken" -eq 2 ]; then
    instructor_report_lookup_failure "'$box' may or may not already be allocated."
    err ""
    err "Provisioning over a box that is already somebody's would take it from"
    err "them, so this stops rather than guessing. Nothing was changed."
    return 8
  fi
  if [ "$taken" -eq 0 ]; then
    err "boxId '$box' is already in use — a live instance carries that tag."
    err "Pick a different id, or remove the existing box first:"
    err "  sfbox instructor list"
    err "  sfbox instructor remove $box"
    err "Nothing was changed."
    return 6
  fi

  [ -n "$keypair" ] || keypair="$box-keypair"
  [ -n "$key_out" ] || key_out="$tf_root/$box-keypair.pem"

  # Mint the key pair if it does not exist yet. The private half is returned
  # once and never again, so it is written straight to a 0600 file — this is
  # the key the participant will be given.
  if aws_cli ec2 describe-key-pairs --key-names "$keypair" >/dev/null 2>&1; then
    say "Reusing the existing EC2 key pair '$keypair'."
    if [ ! -f "$key_out" ]; then
      warn "but its private half is not at $key_out."
      warn "AWS returns a private key once, at creation, and never again. If you"
      warn "cannot find it, delete the key pair and re-run so a fresh one is minted."
    fi
  else
    say "Creating the EC2 key pair '$keypair' ..."
    local material
    material="$(aws_cli ec2 create-key-pair --key-name "$keypair" \
                  --query KeyMaterial --output text 2>/dev/null)"
    if [ -z "$material" ]; then
      err "could not create the EC2 key pair '$keypair'."
      err "Nothing was changed."
      return 1
    fi
    ( umask 077; printf '%s\n' "$material" >"$key_out" ) || {
      err "could not write the private key to $key_out"
      return 1
    }
    chmod 600 "$key_out" 2>/dev/null || true
    say "Private key written to $key_out (0600)."
  fi

  echo
  say "Plan for '$box':"
  say "  root      $tf_root"
  say "  workspace $box"
  say "  key pair  $keypair"
  [ -n "$packs_ref" ] && say "  packs ref $packs_ref (overriding the module default)"
  say "  apply     modules/gas-city-instance"
  echo
  if [ "$assume_yes" = 0 ]; then
    printf '==> Continue? [y/N] '
    local reply; read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) say "Nothing changed."; return 0 ;; esac
  fi

  say "Initialising Terraform ..."
  tf_cli -chdir="$tf_root" init -input=false >/dev/null || {
    err "terraform init failed in $tf_root"; return 1; }
  instructor_tf_workspace "$tf_root" "$box" || return 1

  local tf_args=(apply -auto-approve -input=false -var "factory_name=$box" -var "keypair_name=$keypair")
  # Exposed as a flag on purpose. The module default pins the toolchain, and a
  # ref whose gc init lacks the flags userdata passes aborts the boot part-way,
  # so the workaround has to be reachable without editing Terraform.
  [ -n "$packs_ref" ] && tf_args+=(-var "factory_packs_ref=$packs_ref")

  say "Applying. First boot builds the toolchain from source, so this is slow."
  if ! tf_cli -chdir="$tf_root" "${tf_args[@]}"; then
    err "terraform apply failed for '$box'."
    err "The workspace is left as Terraform found it — inspect it with:"
    err "  terraform -chdir=$tf_root workspace select $box && terraform -chdir=$tf_root show"
    return 1
  fi

  # The three things a participant needs, in the order save-credential wants.
  local host fingerprint instance_id
  instance_id="$(instructor_tf_output "$tf_root" instance_id)"
  host="$(instructor_tf_output "$tf_root" public_ip)"
  [ -n "$host" ] || host="$(instructor_tf_output "$tf_root" public_dns)"
  [ -n "$host" ] || host="$(instructor_tf_output "$tf_root" host)"
  if [ -z "$host" ] && [ -n "$instance_id" ]; then
    host="$(aws_cli ec2 describe-instances --instance-ids "$instance_id" \
              --query 'Reservations[].Instances[].PublicIpAddress' --output text 2>/dev/null \
            | grep -v '^None$' | head -1)"
  fi

  if [ -z "$host" ]; then
    err "'$box' applied, but it has no address a participant can reach."
    err ""
    err "As merged, modules/gas-city-instance puts the instance in a private subnet"
    err "with associate_public_ip_address = false, and exposes neither a public IP"
    err "nor a host-key fingerprint as an output. Its documented way in is SSM,"
    err "which participants cannot use because they hold no AWS credentials."
    err ""
    err "The box itself is up and Terraform state is correct — this is a gap in the"
    err "module, not a failed apply. Give the instance a public address and expose"
    err "it as a 'public_ip' output on your root, then re-run to get the handoff."
    err ""
    err "Nothing was destroyed. Remove it with: sfbox instructor remove $box"
    return 7
  fi

  say "Reading the host key from $host ..."
  local scan
  scan="$(keyscan_cli -T 20 "$host" 2>/dev/null | grep -v '^#' || true)"
  if [ -n "$scan" ]; then
    fingerprint="$(printf '%s\n' "$scan" | keygen_cli -lf - 2>/dev/null | awk '{print $2}' | head -1)"
  fi
  if [ -z "${fingerprint:-}" ]; then
    warn "the box is not answering on :22 yet, so its fingerprint is not readable."
    warn "First boot takes a while. Re-read it once it is up with:"
    warn "  ssh-keyscan -T 20 $host | ssh-keygen -lf -"
    fingerprint="<run ssh-keyscan once the box answers>"
  fi

  echo
  say "Provisioned '$box'."
  echo
  printf 'key          %s\n' "$key_out"
  printf 'host         %s\n' "$host"
  printf 'fingerprint  %s\n' "$fingerprint"
  echo
  say "Send the participant the key file and this line:"
  echo
  printf '  sfbox save-credential --box %s --host %s --key %s --fingerprint %s\n' \
    "$box" "$host" "$(basename "$key_out")" "$fingerprint"
  echo
  say "Those are the three inputs save-credential takes, in its own order."
  return 0
}

cmd_instructor_remove() {
  local box="" tf_root="${SFBOX_TF_ROOT:-}" keypair="" assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tf-root) tf_root="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --keypair) keypair="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --region)  SFBOX_AWS_REGION="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --profile) SFBOX_AWS_PROFILE="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -y|--yes)  assume_yes=1; shift ;;
      -h|--help) usage_instructor; return 0 ;;
      -*)        err "instructor remove: unknown argument '$1'"; return 2 ;;
      *)         if [ -z "$box" ]; then box="$1"; shift
                 else err "instructor remove: unexpected argument '$1'"; return 2; fi ;;
    esac
  done

  instructor_validate_box_id "$box" || return $?
  instructor_require_aws || return $?
  instructor_require_tf "$tf_root" || return $?

  # Mirrors provision's default. Terraform still evaluates the whole root on a
  # destroy, so every required variable needs a value even though the resources
  # are on their way out — and keypair_name has no default in the example root.
  [ -n "$keypair" ] || keypair="$box-keypair"

  echo
  say "About to DESTROY '$box' and everything the module created for it:"
  say "  the instance, its home volume, its log group and its security group."
  say "The home volume holds that participant's city, its Dolt databases and"
  say "their Claude credentials. Destroying it is not reversible."
  echo
  if [ "$assume_yes" = 0 ]; then
    printf "==> Type the boxId to confirm: "
    local reply; read -r reply
    if [ "$reply" != "$box" ]; then
      say "That did not match. Nothing was destroyed."
      return 0
    fi
  fi

  say "Initialising Terraform ..."
  tf_cli -chdir="$tf_root" init -input=false >/dev/null || {
    err "terraform init failed in $tf_root"; return 1; }
  instructor_tf_workspace "$tf_root" "$box" || return 1

  # Destroy rather than terminate-instances on purpose: it takes the dependent
  # graph with it and leaves state truthful, so no elastic IP or volume is left
  # billing quietly after the cohort ends.
  say "Destroying '$box' ..."
  if ! tf_cli -chdir="$tf_root" destroy -auto-approve -input=false \
       -var "factory_name=$box" -var "keypair_name=$keypair"; then
    err "terraform destroy failed for '$box'."
    err "Some resources may still exist. Check with:"
    err "  terraform -chdir=$tf_root workspace select $box && terraform -chdir=$tf_root state list"
    err "Do not fall back to terminating the instance by hand — that leaves the"
    err "volume and its elastic IP behind, still billing, with state now wrong."
    return 1
  fi

  say "Destroyed '$box'. Its Terraform workspace is kept, holding empty state."
  say "The participant can drop their local copy with: sfbox box forget $box"
  return 0
}

cmd_instructor_list() {
  local tag_key="$SFBOX_DEFAULT_TAG_KEY" tag_value="$SFBOX_DEFAULT_TAG_VALUE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --region)    SFBOX_AWS_REGION="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --profile)   SFBOX_AWS_PROFILE="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --tag-key)   tag_key="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      --tag-value) tag_value="${2:-}"; shift 2 || die "'$1' needs a value" ;;
      -h|--help)   usage_instructor; return 0 ;;
      *)           err "instructor list: unknown argument '$1'"; return 2 ;;
    esac
  done

  instructor_require_aws || return $?

  # Deliberately not one pipeline: a pipeline hands back awk's exit status, and
  # an errored describe would then reach the formatter as an empty result and
  # print the friendly "nothing tagged" text below, naming the wrong cause. This
  # is the list an instructor allocates ids against, so it stops instead.
  local rows table
  if ! rows="$(instructor_describe_rows "$tag_key" "$tag_value")"; then
    instructor_report_lookup_failure "the box list would be wrong and is not shown."
    err ""
    err "An id missing from a half-answered list looks free when it is not."
    return 8
  fi
  table="$(printf '%s\n' "$rows" | instructor_live_rows | instructor_format_rows)"
  if [ "$table" = "__SFBOX_NO_ROWS__" ]; then
    say "No workshop boxes tagged $tag_key=$tag_value in ${SFBOX_AWS_REGION:-your default region}."
    echo
    say "If you expected some, the tag is the likely reason. The gas-city-instance"
    say "module tags an instance with its Name only, so the workshop tag comes from"
    say "your own root — add it once to the AWS provider and it lands on everything:"
    echo
    say "  provider \"aws\" { default_tags { tags = { $tag_key = \"$tag_value\" } } }"
    echo
    say "Or point this at whatever you already use: --tag-key K --tag-value V"
    return 0
  fi
  printf '%s\n' "$table"
  echo
  say "boxId is the Name tag. An id listed here is taken — provision refuses it."
  return 0
}

cmd_instructor() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    provision) cmd_instructor_provision "$@" ;;
    remove)    cmd_instructor_remove "$@" ;;
    list)      cmd_instructor_list "$@" ;;
    ""|-h|--help) usage_instructor ;;
    *) err "instructor: unknown subcommand '$sub' (want: provision, remove, list)"; return 2 ;;
  esac
}

# ----------------------------------------------------------------- usage ----

usage_instructor() {
  cat <<'EOF'
usage: sfbox instructor provision <boxId> [--tf-root <dir>] [--factory-packs-ref <ref>]
                                          [--keypair <name>] [--key-out <path>]
                                          [--region <r>] [--profile <p>] [--yes]
       sfbox instructor remove <boxId> [--tf-root <dir>] [--keypair <name>]
                                       [--region <r>] [--profile <p>] [--yes]
       sfbox instructor list [--tag-key <k>] [--tag-value <v>] [--region <r>] [--profile <p>]

For whoever runs the workshop. These need AWS credentials; participants have
none by design and never need these commands.

provision  Applies actualclaw's modules/gas-city-instance for one box, then
           prints the three things save-credential takes: the private key, the
           host, and the host-key fingerprint. Refuses a boxId that is already
           taken. Each box gets its own Terraform workspace, so provisioning a
           second box cannot disturb the first.

           --factory-packs-ref  Override the module's pinned packs ref. Needed
                                while a ref whose gc init lacks the flags the
                                boot script passes would abort the build.

remove     Terraform destroy, not terminate-instances. It takes the dependent
           graph with it and leaves state truthful, so no volume or elastic IP
           is left billing after the cohort ends.

list       Every live box carrying the workshop tag, with its boxId and stats.
           This is how you find out an id is already allocated. If the lookup
           itself fails, it says so and stops rather than showing you an empty
           list you would read as "that id is free".

--tf-root  The workspace you copied from actualclaw's
           modules/gas-city-instance/example/ and filled in. Defaults to
           $SFBOX_TF_ROOT.
EOF
}

usage_save_credential() {
  cat <<'EOF'
usage: sfbox save-credential --box <boxId> --host <ip> --key <path> --fingerprint <fp>
                             [--user ubuntu] [--port 22] [--label prod|test]
                             [--city <name>] [--rotate]

Stores one box's credential locally and pins its host key.

  --fingerprint  Required. Your instructor emits it with the key. Pinning it
                 means the first connection is authenticated, and a rebuilt box
                 says "replaced" instead of looking like an attack.
  --rotate       Replace the pinned host key for a box you already saved. You
                 still pass the NEW fingerprint; --rotate only says the change
                 was expected.
EOF
}

usage_deploy_factory() {
  cat <<'EOF'
usage: sfbox deploy-factory <github-url> [--box <boxId>] [--version sha:<commit>]
                            [--city-path <path>] [--keep-existing] [--yes]

Makes a pack the top-level factory on your box, then restarts it.

  <github-url>   https://github.com/<org>/<repo>/tree/<ref>/<subdir>
  --version      Pin a commit yourself. Otherwise the ref is resolved for you.
  --keep-existing  Leave the current imports in place instead of replacing them.

Before restarting, every agent prompt is rendered and measured. If one is too
large to exec, the deploy is refused and the import rolled back, so your box
keeps running the factory it already had.
EOF
}

usage() {
  cat <<EOF
sfbox $SFBOX_VERSION — drive your Software Factory Intensive boxes over SSH.

usage: sfbox <command> [options]

Setting up
  save-credential   Save a box's key and pin its host key
  box list          Show your boxes and which one is current
  box use <id>      Make a box the default for later commands
  box current       Print the current box
  box forget <id>   Drop a box locally (the box itself is untouched)
  preflight         Check ssh, gc and the service, so you know which layer broke

Working
  start-session     Open a shell on the box
  deploy-factory    Install a pack as the top-level factory and restart
  restart-factory   Restart the Gas City service
  dashboard         Tunnel the dashboard to your browser
  get-box           Service state, sessions and recent log

Every command takes --box <boxId> to override the current box.
State lives in $SFBOX_HOME, which sfbox owns.

Running the workshop (needs AWS credentials; participants have none)
  instructor provision <id>   Build a box and print its key, host and fingerprint
  instructor remove <id>      Destroy a box and everything it created
  instructor list             Live boxes and which ids are taken
EOF
}

# ------------------------------------------------------------------ main ----

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    save-credential) cmd_save_credential "$@" ;;
    box)             cmd_box "$@" ;;
    preflight)       cmd_preflight "$@" ;;
    start-session)   cmd_start_session "$@" ;;
    deploy-factory)  cmd_deploy_factory "$@" ;;
    restart-factory) cmd_restart_factory "$@" ;;
    dashboard)       cmd_dashboard "$@" ;;
    get-box)         cmd_get_box "$@" ;;
    instructor)      cmd_instructor "$@" ;;
    version|--version) printf 'sfbox %s\n' "$SFBOX_VERSION" ;;
    ""|-h|--help|help) usage ;;
    *) err "unknown command '$cmd'"; echo; usage; exit 2 ;;
  esac
}

# Sourcing the script exposes its functions without running anything, which is
# what tests/run-tests.sh does.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
